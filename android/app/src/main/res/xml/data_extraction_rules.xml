<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-to-device transfer for the saved addresses, the login cookie or any app state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
