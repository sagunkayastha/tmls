[32m+[m[32m  sleep 0.1[m
[32m+[m[32mdone[m
[32m+[m[32mif (( ! ok )); then[m
[32m+[m[32m  printf '\033[1;31m%s\033[0m\n' "receiver did not see the probe — kitty with \`s0 recv\` is not focused (or recv not running). Nothing else was typed. Click the kitty window and rerun." >&2[m
[32m+[m[32m  exit 2[m
[32m+[m[32mfi[m
